{
  "name": "@vault-mcp/conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm --prefix ../vault-mcp-api run build",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "conformance": "node --import tsx src/kernel/main.ts",
    "test": "tsc --noEmit && node --import tsx --test 'tests/*.test.mjs'",
    "pretest": "npm --prefix ../core run build"
  },
  "dependencies": {
    "@vault-mcp/core": "*",
    "vault-mcp-api": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
